<Window x:Class="sistem_pencarian_SPKLU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sistem_pencarian_SPKLU"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="SPKLU Finder &amp; Interactive Map"
        Height="850" Width="1280"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPageBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Statistics Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer / Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER PANEL -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="24,16" Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SPKLU Finder &amp; Interactive Map" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    <TextBlock Text="Sistem Pencarian dan Navigasi Stasiun Pengisian Kendaraan Listrik Umum Terpadu" 
                               FontSize="12" Foreground="#94A3B8" Margin="38,4,0,0"/>
                </StackPanel>

                <!-- Network Status Pill -->
                <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="20" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Database SPKLU Aktif (In-Memory)" FontSize="12" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. STATISTIC CARDS -->
        <Grid Grid.Row="1" Margin="24,18,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total SPKLU -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL SPKLU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="txtTotalSpklu" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Stasiun Terdaftar" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="10" Width="42" Height="42" VerticalAlignment="Center">
                        <TextBlock Text="🔌" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Tersedia -->
            <Border Grid.Column="1" Margin="5,0,5,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="STATUS TERSEDIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreenDarkBrush}"/>
                        <TextBlock x:Name="txtTotalTersedia" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentGreenDarkBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Siap Digunakan" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="10" Width="42" Height="42" VerticalAlignment="Center">
                        <TextBlock Text="✅" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: DC Fast Charging -->
            <Border Grid.Column="2" Margin="5,0,5,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DC FAST CHARGING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                        <TextBlock x:Name="txtTotalFast" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Daya 50 - 60 kW" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="10" Width="42" Height="42" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="18" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: DC Ultra Fast Charging -->
            <Border Grid.Column="3" Margin="10,0,0,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ULTRA FAST CHARGING" FontSize="11" FontWeight="Bold" Foreground="#7C3AED"/>
                        <TextBlock x:Name="txtTotalUltraFast" Text="0" FontSize="24" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                        <TextBlock Text="Daya 150 - 200 kW" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F5F3FF" CornerRadius="10" Width="42" Height="42" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. MAIN WORKSPACE (LEFT PANEL: List/Filter | RIGHT PANEL: Map & Detail) -->
        <Grid Grid.Row="2" Margin="24,14,24,16">
            <Grid.ColumnDefinitions>
                <!-- Left Panel -->
                <ColumnDefinition Width="1.15*"/>
                <!-- Divider -->
                <ColumnDefinition Width="16"/>
                <!-- Right Panel -->
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT PANEL ================= -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Filter & Search Controls -->
                        <RowDefinition Height="Auto"/>
                        <!-- Results Count Label -->
                        <RowDefinition Height="Auto"/>
                        <!-- DataGrid Table -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Controls Section -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <!-- Search Box -->
                        <TextBlock Text="Pencarian SPKLU" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="txtSearch" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Padding="32,8,10,8" 
                                     TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock Text="🔍" FontSize="13" Foreground="#94A3B8" 
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="txtSearchPlaceholder" Text="Ketik nama stasiun, kota, atau alamat..." 
                                       FontSize="13" Foreground="#94A3B8" 
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,0,0,0" 
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Filter Dropdowns & Reset Button -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tipe Charger ComboBox -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipe Charger" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbTipeCharger" Style="{StaticResource ModernComboBoxStyle}" Height="36" SelectionChanged="CmbFilter_SelectionChanged">
                                    <ComboBoxItem Content="Semua Tipe Charger" IsSelected="True"/>
                                    <ComboBoxItem Content="AC Fast Charging"/>
                                    <ComboBoxItem Content="DC Fast Charging"/>
                                    <ComboBoxItem Content="DC Ultra Fast Charging"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Status ComboBox -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status Operasional" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbStatus" Style="{StaticResource ModernComboBoxStyle}" Height="36" SelectionChanged="CmbFilter_SelectionChanged">
                                    <ComboBoxItem Content="Semua Status" IsSelected="True"/>
                                    <ComboBoxItem Content="Tersedia"/>
                                    <ComboBoxItem Content="Terpakai"/>
                                    <ComboBoxItem Content="Maintenance"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Reset Button -->
                            <Button x:Name="btnReset" Grid.Column="4" Style="{StaticResource OutlineButtonStyle}" 
                                    Content="Reset Filter" Height="36" VerticalAlignment="Bottom" Click="BtnReset_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Record Count Header -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,1" Padding="8,6" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock x:Name="txtRecordCount" Text="Menampilkan 0 SPKLU" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}"/>
                            <TextBlock Text="* Klik baris untuk melihat detail &amp; peta" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid x:Name="dgSpklu" Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="White"
                              RowHeight="44"
                              BorderThickness="1"
                              BorderBrush="{StaticResource BorderLightBrush}"
                              SelectionChanged="DgSpklu_SelectionChanged">

                        <DataGrid.Resources>
                            <!-- Header Style -->
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#475569" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>

                            <!-- Row Style -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="SnapsToDevicePixels" Value="true"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Nama SPKLU & Kota -->
                            <DataGridTemplateColumn Header="Nama SPKLU / Kota" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NamaStasiun}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDarkBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Kota}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Tipe Charger -->
                            <DataGridTemplateColumn Header="Tipe Charger" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TipeCharger}" FontSize="12" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Daya (kW) -->
                            <DataGridTemplateColumn Header="Daya" Width="0.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DayaDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Port -->
                            <DataGridTemplateColumn Header="Port" Width="0.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PortDisplay}" FontSize="12" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBgColor}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusTextColor}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ================= RIGHT PANEL ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Map View Container -->
                    <RowDefinition Height="1.1*"/>
                    <!-- Margin Divider -->
                    <RowDefinition Height="14"/>
                    <!-- Detail Panel Container -->
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- 1. MAP VIEW CONTAINER -->
                <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Map Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📍" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Peta Interaktif (OpenStreetMap &amp; Leaflet)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="txtMapCoordBadge" Text="-7.2654, 112.7482" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- WebView2 Control Area -->
                        <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" Background="#0F172A" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <Grid>
                                <wv2:WebView2 x:Name="MapWebView" />
                                
                                <!-- Loading / Fallback Indicator -->
                                <Border x:Name="bdrMapFallback" Background="#1E293B" Visibility="Collapsed" Padding="20">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🗺️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="txtMapFallback" Text="Memuat Peta Interaktif SPKLU..." 
                                                   FontSize="13" Foreground="#E2E8F0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. DETAIL PANEL CONTAINER -->
                <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Detail Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Panel Detail SPKLU" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                            </StackPanel>
                            <!-- Selected Status Badge -->
                            <Border x:Name="bdrDetailStatus" Background="#D1FAE5" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="txtDetailStatus" Text="Tersedia" Foreground="#065F46" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <!-- Detail Body Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Station Name -->
                                <TextBlock x:Name="txtDetailNama" Text="SPKLU PLN UID Jawa Timur" 
                                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap"/>
                                
                                <!-- Location Address -->
                                <TextBlock x:Name="txtDetailAlamat" Text="Jl. Embong Trengguli No. 19-21, Genteng, Surabaya" 
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <Separator Background="{StaticResource BorderLightBrush}" Margin="0,0,0,10"/>

                                <!-- Detail Key-Value Specs Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Kota & Tipe -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,10">
                                        <TextBlock Text="Kota / Wilayah" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="txtDetailKota" Text="Surabaya" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,10">
                                        <TextBlock Text="Tipe Charger" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="txtDetailTipe" Text="DC Fast Charging" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Row 1: Daya & Port -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,10">
                                        <TextBlock Text="Kapasitas Daya Max" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="txtDetailDaya" Text="50 kW" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,10">
                                        <TextBlock Text="Jumlah Port Charging" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="txtDetailPort" Text="2 Port" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Row 2: Tarif & Koordinat -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Tarif Pengisian Daya" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="txtDetailTarif" Text="Rp 2.466 / kWh" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Koordinat Lokasi" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="txtDetailKoordinat" Text="-7.2654, 112.7482" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Buttons -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnGoogleMaps" Grid.Column="0" Style="{StaticResource NavButtonStyle}" 
                                    Content="🧭 Buka di Google Maps" Height="40" Click="BtnGoogleMaps_Click"/>

                            <Button x:Name="btnCopyCoords" Grid.Column="2" Style="{StaticResource OutlineButtonStyle}" 
                                    Content="📋 Salin Koordinat" Height="40" Click="BtnCopyCoords_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. FOOTER / STATUS BAR -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="24,8">
            <Grid>
                <TextBlock Text="Sistem Pencarian SPKLU &amp; Maps © 2026 - PBKK Week 8" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="Didukung oleh OpenStreetMap &amp; Leaflet.js" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
